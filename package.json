{
  "name": "watershed",
  "version": "0.1.0",
  "homepage": ".",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@react-three/rapier": "^2.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "0.185.0",
    "zustand": "^5.0.13"
  },
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "build:full": "pnpm build:wasm && vite build",
    "build:analyze": "ANALYZE=1 vite build",
    "build_colab": "npm run build:wasm_colab && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit && node scripts/check-typecheck-surface.mjs && node scripts/check-systems-layout.mjs && node scripts/check-glsl-hosts.mjs && node scripts/check-orphans.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual-smoke": "node verification/visual_smoke.mjs",
    "test:visual-smoke:update": "UPDATE_BASELINES=1 node verification/visual_smoke.mjs",
    "test:input-smoke": "node verification/input_script_smoke.mjs",
    "test:wasm": "WATERSHED_WASM_INTEGRATION=1 vitest run src/systems/water/WatershedWasm.integration.test.ts src/systems/water/sweScroll.integration.test.ts src/systems/water/hydroContrast.test.ts src/rendering/gpuChores/watershedHost.integration.test.ts src/sim/simWorker.integration.test.ts src/terrain/__tests__/terrainParity.test.ts",
    "build:wasm": "cd emscripten && bash build.sh",
    "build:wasm_colab": "cd emscripten && bash build_colab.sh",
    "build:wasm:threads": "cd emscripten && bash build.sh --threads",
    "build:wasm:threads_colab": "cd emscripten && bash build_colab.sh --threads",
    "build:wasm:debug": "cd emscripten && bash build.sh --debug",
    "test:wasm:parity": "WATERSHED_WASM_INTEGRATION=1 vitest run src/physics/__tests__/waterForceParity.test.ts",
    "test:wgsl": "node verification/swe_wgsl_parity.mjs",
    "test:post-parity": "node verification/post_parity.mjs",
    "test:native": "cmake -S emscripten -B emscripten/build-host && cmake --build emscripten/build-host && emscripten/build-host/watershed_host_smoke",
    "test:native:sanitize": "cmake -S emscripten -B emscripten/build-host-asan -DWATERSHED_SANITIZE=ON && cmake --build emscripten/build-host-asan && emscripten/build-host-asan/watershed_host_smoke",
    "lint:native": "cmake -S emscripten -B emscripten/build-host >/dev/null && ${CLANG_TIDY:-clang-tidy} -p emscripten/build-host --quiet emscripten/swe.cpp emscripten/forces.cpp emscripten/chores.cpp emscripten/particles.cpp emscripten/routing.cpp emscripten/terrain.cpp emscripten/bindings.cpp emscripten/swe_fuzz.cpp emscripten/chores_fuzz.cpp emscripten/forces_fuzz.cpp emscripten/terrain_fuzz.cpp",
    "test:native:fuzz": "bash scripts/native-fuzz.sh",
    "test:visual-smoke:tsl": "VISUAL_EXTRA_QUERY=material=tsl node verification/visual_smoke.mjs",
    "test:visual-smoke:tsl:update": "UPDATE_BASELINES=1 VISUAL_EXTRA_QUERY=material=tsl node verification/visual_smoke.mjs",
    "profile:physics": "node verification/physics_profile.mjs",
    "compile:validators": "node scripts/compile-validators.mjs",
    "profile:swe": "node verification/swe_step_bench.mjs",
    "profile:spawn": "node verification/spawn_profile.mjs",
    "verify:deploy": "node verification/verify_deploy.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "pnpm": {
    "overrides": {
      "@dimforge/rapier3d-compat": "0.19.2"
    }
  },
  "devDependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@eslint/js": "^10.0.1",
    "@react-three/eslint-plugin": "^0.1.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.32",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.8",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@webgpu/types": "^0.1.64",
    "ajv": "^8.18.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.37.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
