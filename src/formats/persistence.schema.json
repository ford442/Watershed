{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://watershed.dev/schemas/persistence.schema.json",
  "title": "WatershedPersistence",
  "type": "object",
  "required": ["version", "settings", "vehicleType", "ghostEnabled", "runs"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "settings": {
      "type": "object",
      "required": ["quality", "soundVolume"],
      "additionalProperties": false,
      "properties": {
        "quality": {
          "type": "string",
          "enum": ["low", "medium", "high", "ultra"]
        },
        "soundVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "vehicleType": {
      "type": "string",
      "enum": ["runner", "raft"]
    },
    "ghostEnabled": {
      "type": "boolean"
    },
    "lastMapId": {
      "type": "string",
      "minLength": 1
    },
    "completedMaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "launchHour": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23
    },
    "runs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["bestScore", "bestAirTime"],
        "additionalProperties": false,
        "properties": {
          "bestScore": {
            "type": "number",
            "minimum": 0
          },
          "bestAirTime": {
            "type": "number",
            "minimum": 0
          },
          "bestTimeMs": {
            "type": "number",
            "minimum": 0
          },
          "ghostData": {
            "type": "string",
            "minLength": 1
          },
          "splits": {
            "$ref": "#/$defs/runSplits"
          }
        }
      }
    },
    "rivals": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["codecVersion", "mapId", "timeMs", "ghostData", "exportedAt"],
        "additionalProperties": false,
        "properties": {
          "codecVersion": {
            "type": "number",
            "minimum": 1
          },
          "mapId": {
            "type": "string",
            "minLength": 1
          },
          "timeMs": {
            "type": "number",
            "minimum": 0
          },
          "ghostData": {
            "type": "string",
            "minLength": 1
          },
          "exportedAt": {
            "type": "number"
          },
          "splits": {
            "$ref": "#/$defs/runSplits"
          },
          "launchHour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          },
          "hydroEventHash": {
            "type": "string",
            "maxLength": 32
          },
          "qualityPreset": {
            "type": "string",
            "enum": ["low", "medium", "high", "ultra"]
          }
        }
      }
    }
  },
  "$defs": {
    "runSplits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segmentIndex", "tMs", "speed"],
        "additionalProperties": false,
        "properties": {
          "segmentIndex": { "type": "number" },
          "tMs": { "type": "number", "minimum": 0 },
          "speed": { "type": "number" }
        }
      }
    }
  }
}
