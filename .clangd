# Host compile database — generated by:
#   cmake -S emscripten -B emscripten/build-host
# WASM configure writes emscripten/build/compile_commands.json (em++) and must
# not be used for editing compute TUs on a machine without emsdk.
If:
  PathMatch: emscripten/.*\.(c|cpp|h|hpp)
CompileFlags:
  CompilationDatabase: emscripten/build-host
