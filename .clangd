# clangd for emscripten/.
#
# Compile database: the host tree, generated (and copied to
# emscripten/compile_commands.json) by `pnpm test:native` / `pnpm lint:native`:
#   cmake -S emscripten -B emscripten/build-host
If:
  PathMatch: emscripten/.*\.(c|cpp|h|hpp)
CompileFlags:
  CompilationDatabase: emscripten/build-host
---
# The TUs that ship in the wasm are read as wasm32 with -msimd128, so the
# editor sees the wasm_simd128 branch of simdf32.h — the one that ships — and
# a 32-bit size_t, not the host's SSE2 branch. The C++ headers come from the
# pinned emsdk's sysroot (`bash scripts/emsdk-pinned.sh` → ./emsdk; the path
# is relative to emscripten/build-host). Host-only sources (smoke, fuzzers,
# goldens, digests) keep the host flags above.
If:
  PathMatch: emscripten/.*\.(c|cpp|h|hpp)
  PathExclude: emscripten/(host_smoke\.cpp|.*_fuzz\.cpp|fuzz_input\.h|native_digest\.h|.*_goldens\.h)
CompileFlags:
  Add:
    - --target=wasm32-unknown-emscripten
    - --sysroot=../../emsdk/upstream/emscripten/cache/sysroot
    - -msimd128
    - -mbulk-memory
