# public/.htaccess — copied to build/.htaccess by Vite and uploaded with the bundle (#461).
#
# This directory owns three things the vhost must not be trusted with:
#   1. Which file the directory URL (/watershed/) serves.
#   2. The charset every HTML/JS/WASM response is labelled with.
#   3. Cross-origin isolation: the web build is single-threaded (emscripten/build.sh,
#      #454) and must NOT require COOP/COEP. Nothing below sets them; if the vhost
#      forces them, they are dropped for this directory only.
#
# Every block is IfModule-guarded so a missing module means "directive ignored",
# not HTTP 500. It cannot guard against AllowOverride forbidding these classes
# (FileInfo / Indexes): then Apache answers 500 for the directory. Rollback is
# deleting the remote .htaccess.

# The directory URL resolves to index.html, never to a stray root HTML file.
<IfModule mod_dir.c>
  DirectoryIndex index.html
</IfModule>

# The transport charset must agree with the bytes (UTF-8, as Vite emits them).
<IfModule mod_mime.c>
  AddDefaultCharset UTF-8
  AddCharset UTF-8 .html .js .wasm
</IfModule>

# `Header` and `Header always` write to different tables; a vhost may use either.
<IfModule mod_headers.c>
  Header unset Cross-Origin-Embedder-Policy
  Header always unset Cross-Origin-Embedder-Policy
  Header unset Cross-Origin-Opener-Policy
  Header always unset Cross-Origin-Opener-Policy
</IfModule>

# --- Cache policy (#485 D) -------------------------------------------------
# Own section on purpose: it is independent of the charset/isolation blocks above
# and of the CSP block, so it merges cleanly with either.
#
# Vite content-hashes everything in assets/ (an 8-char Rollup hash before the
# extension), so a changed file always has a new name: those can be cached for a
# year and never revalidated. The names that do NOT change when their bytes do
# (index.html, BUILD_ID, the emcc pair watershed_native.*) must be revalidated on
# every visit or a deploy would be invisible. `Header set` (not `always`) only
# touches successful responses, so a 404 for a hashed name is never pinned.
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|BUILD_ID|watershed_native\..*)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Script policy (#467). watershed_native no longer needs eval: the glue is a
# plain ES module (no Embind invokers) imported by URL, and only
# WebAssembly.instantiate needs 'wasm-unsafe-eval'. Report-Only until #485
# drops the runtime ajv schema compiler (`new Function` at module load in
# levelValidator / reachValidator / PersistenceSystem) — enforcing it before
# then blanks the page. Then rename the header to Content-Security-Policy.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy-Report-Only "script-src 'self' 'wasm-unsafe-eval'"
</IfModule>